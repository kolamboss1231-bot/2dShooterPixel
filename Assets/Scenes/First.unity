  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb08a8fcafb5ac44ea59cb55ce3e748c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  Name: PoliceMan
  sentences:
  - "\u0412\u044B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C,
    \u043F\u0440\u043E\u0448\u043B\u043E \u043C\u043D\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
  - "\u0411\u044B\u043B\u0438 \u0441\u043B\u044B\u0448\u043D\u044B \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u044B,
    \u043F\u043E\u0445\u043E\u0436\u0435 \u0432\u0441\u0435 \u043E\u0441\u043B\u043E\u0436\u043D\u0438\u043B\u043E\u0441\u044C"
  - "\u0412 \u0437\u0434\u0430\u043D\u0438\u0438 \u043E\u043A\u043E\u043B\u043E 15
    \u043D\u0435\u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445
    \u043B\u0438\u0446"
  - "\u0421\u043D\u0430\u0439\u043F\u0435\u0440\u0441\u043A\u0438\u0439 \u0432\u0437\u0432\u043E\u0434
    \u043F\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
    \u0431\u0443\u0434\u0435\u0442 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0443"
  - "\u0414\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u043F\u043E
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438"
  - 
